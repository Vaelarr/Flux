rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection: readable and writable for registered demo users and password reset workflow
    match /users/{userId} {
      allow read: if true;
      allow create: if request.resource.data.email is string;
      allow update, delete: if true;
    }

    // Password resets: challenge records for OTP and magic links
    match /password_resets/{resetId} {
      allow read, write: if true;
    }

    // Security audit logs: write-only append or read by inspector
    match /security_logs/{logId} {
      allow read, write: if true;
    }
  }
}
