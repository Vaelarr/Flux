# Server-only values. Never prefix database, SMTP, or auth secrets with VITE_.
TURSO_AUTH_TOKEN=
TURSO_DATABASE_URL=

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# The public HTTPS URL used in recovery emails; do not include a trailing path.
APP_URL=https://flux-ph.vercel.app

# Brevo SMTP tab: login and SMTP key (not a Brevo API key).
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Flux
BREVO_SMTP_PORT=587

# Optional, when keeping Google/Apple sign-in through your existing Firebase project.
# These identify the public client project; no Firebase database is used.
FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
